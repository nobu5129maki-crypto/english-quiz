# 入口は index.php のログイン画面。中身はログイン後だけ gate.php が渡す。
DirectoryIndex index.php
Options -Indexes -MultiViews

<FilesMatch "^(auth\.php|index\.html)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^index\.php$ - [L]
RewriteRule ^gate\.php$ - [L]
# ホーム画面への追加は、Chrome がログインのクッキーなしで取りに来る。
# マニフェスト、192/512 アイコン、サービスワーカーだけ公開する。
RewriteRule ^manifest\.json$ - [L]
RewriteRule ^sw\.js$ - [L]
RewriteRule ^icon-192\.png$ - [L]
RewriteRule ^icon-512\.png$ - [L]
RewriteRule ^auth\.php$ - [F,L]
RewriteRule ^index\.html$ - [F,L]
RewriteRule ^$ index.php [L]
RewriteRule ^(.*)$ gate.php?mw_path=$1 [B,L,QSA]

<IfModule mod_mime.c>
  AddType application/manifest+json .json
  AddType application/javascript .js
  AddType audio/mpeg .mp3
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <Files "manifest.json">
    Header set Content-Type "application/manifest+json; charset=UTF-8"
    Header set Cache-Control "public, max-age=3600"
  </Files>
  <Files "sw.js">
    Header set Content-Type "application/javascript; charset=UTF-8"
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
